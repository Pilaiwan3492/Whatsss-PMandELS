# ==============================================================================
# Whatsss — Local Environment Configuration Template
# ==============================================================================
# IMPORTANT: This file is for local development only. Do not commit actual secrets.
# Ensure that your local .env file is included in .gitignore.

# PostgreSQL Container Configuration (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsss_db
POSTGRES_PORT=5432

# Application Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection URL (Prisma ORM & Backend)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsss_db?schema=public"

# Authentication Security (JWT Secret for Local Development)
# Replace this placeholder with a unique, cryptographically random secret on your machine.
JWT_SECRET=replace_with_a_long_random_secret_for_local_development
JWT_EXPIRES_IN=1d
