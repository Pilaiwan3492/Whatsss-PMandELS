# ==============================================================================
# Whatsss — Environment Configuration Template
# ==============================================================================
# IMPORTANT: This file contains configuration keys and safe placeholder values only.
# Do NOT commit actual secrets or production credentials to version control.
# Copy this file to .env and adjust values for your environment.
#
# SECURITY ENFORCEMENT: The application actively inspects configured secrets upon
# startup and seed execution. Any values retaining template placeholder strings
# (e.g. containing 'replace_with' or 'changeme') will cause the server or seed
# process to abort immediately with a FATAL security error.

# ------------------------------------------------------------------------------
# Server Network & Host Configuration
# ------------------------------------------------------------------------------
# PORT: HTTP server listening port (Cloud Run sets PORT automatically to 8080; default: 8080)
PORT=8080
# HOST: Listening host interface (0.0.0.0 required for container environments)
HOST=0.0.0.0
# CLIENT_URL: Full public URL of the application.
# REQUIRED in production: csrfGuard strictly verifies incoming request Origin against CLIENT_URL
# for mutating requests (POST, PUT, PATCH, DELETE), even in single-container deployments.
# - For Docker Compose / Cloud Run single-container: http://localhost:8080 (or your Cloud Run URL)
# - For local split dev (Vite on 5173 + Express on 5000): http://localhost:5173
CLIENT_URL=http://localhost:8080
# NODE_ENV: Application environment ('development' | 'test' | 'production')
NODE_ENV=production

# ------------------------------------------------------------------------------
# Database Connection (Prisma ORM & PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL Container Configuration (for local Docker Compose)
# MANDATORY FOR LOCAL COMPOSE: You must configure a local-only password.
# Never reuse local passwords for GCP Cloud SQL or production environments.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password_for_local
POSTGRES_DB=whatsss_db
POSTGRES_PORT=5432

# DATABASE_URL: PostgreSQL connection string for host-level execution (e.g. local dev or migration runner)
# Note: Ensure the credentials in DATABASE_URL match POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_PORT
DATABASE_URL="postgresql://postgres:replace_with_secure_postgres_password_for_local@localhost:5432/whatsss_db?schema=public"

# DOCKER_DATABASE_URL: Optional override for Docker Compose app/migrate containers.
# Defaults automatically to the internal compose network service:
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
# DOCKER_DATABASE_URL=

# ------------------------------------------------------------------------------
# Authentication & JWT Security
# ------------------------------------------------------------------------------
# JWT_SECRET: Cryptographically secure key for signing auth tokens (min 32 characters in production)
# MANDATORY: You MUST replace this placeholder with a random 32+ character key (e.g. `openssl rand -hex 32`).
# The server will abort startup if this placeholder is left unchanged.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters_for_production
# JWT_EXPIRES_IN: Token expiration duration (e.g. 24h, 1d)
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# Application Metadata & Observability
# ------------------------------------------------------------------------------
# APP_COMMIT_SHA: Git commit SHA injected during CI/CD build for /api/health and /api/ready
APP_COMMIT_SHA=development

# ------------------------------------------------------------------------------
# Production Database Seeding Controls (server/prisma/seed.ts)
# ------------------------------------------------------------------------------
# SEED_ADMIN_PASSWORD: Password for initial admin provisioning (min 12 characters, required in production)
# MANDATORY: You MUST configure a real secure password of at least 12 characters.
# The seed process will abort immediately if this placeholder is left unchanged.
SEED_ADMIN_PASSWORD=replace_with_secure_admin_password_min_12_chars
# SEED_ADMIN_EMAIL: Email for initial admin (default: admin@whatsss.local)
SEED_ADMIN_EMAIL=admin@whatsss.local

# SEED_DEMO_DATA: Set to 'true' to provision demo USER account (user_demo) in production (default: false)
SEED_DEMO_DATA=false
# SEED_DEMO_PASSWORD: Password for user_demo (min 12 characters, required if SEED_DEMO_DATA=true)
# If SEED_DEMO_DATA=true, you MUST configure a real secure password of at least 12 characters.
SEED_DEMO_PASSWORD=replace_with_secure_demo_password_min_12_chars
# SEED_DEMO_EMAIL: Email for user_demo (default: user_demo@whatsss.local)
SEED_DEMO_EMAIL=user_demo@whatsss.local

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: Backend API base URL.
# In development: defaults to http://localhost:5000/api
# In production single-container: defaults to relative /api
VITE_API_BASE_URL=/api
