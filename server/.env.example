# ==============================================================================
# Whatsss Server — Environment Configuration Template
# ==============================================================================
# Server Network & Host Configuration
PORT=5000
HOST=0.0.0.0
# CLIENT_URL: Full public URL of the application (e.g. https://<cloud-run-service-url> or http://localhost:5173).
# REQUIRED in production: csrfGuard strictly verifies incoming request Origin against CLIENT_URL
# for mutating requests (POST, PUT, PATCH, DELETE), even in single-container deployments.
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Database Connection (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsss_db?schema=public"

# Authentication & JWT Security
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters_for_production
JWT_EXPIRES_IN=24h

# Application Metadata & Observability
APP_COMMIT_SHA=development

# Production Database Seeding Controls
SEED_ADMIN_PASSWORD=replace_with_secure_admin_password_min_12_chars
SEED_ADMIN_EMAIL=admin@whatsss.local
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=replace_with_secure_demo_password_min_12_chars
SEED_DEMO_EMAIL=user_demo@whatsss.local
